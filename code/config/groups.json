{
  "G0": {
    "description": "无工具，语料整篇塞进上下文（仅 S 档，1M 上下文下才可行）",
    "tools": [],
    "context_files": false
  },
  "G1": {
    "description": "纯只读 CLI：read / grep / find / ls（corpus_guard 限制在 cwd 内）",
